{
  "name": "@usevibejs/i18n",
  "version": "0.1.0",
  "description": "Every Language. One Framework. ICU-powered internationalization for vibe.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibei18n.git"
  },
  "bin": {
    "vibei18n": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "compositions"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/types/src/core/index.d.ts",
      "import": "./dist/core.mjs"
    },
    "./router": {
      "types": "./dist/types/src/router/index.d.ts",
      "import": "./dist/router.mjs"
    },
    "./tooling": {
      "types": "./dist/types/tooling/index.d.ts",
      "import": "./dist/tooling.mjs"
    },
    "./vite": {
      "types": "./dist/types/tooling/vite.d.ts",
      "import": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.declarations.json",
    "typecheck": "tsc --noEmit && tsc -b examples/showcase --runExternalCode && node scripts/template-types.ts",
    "lint": "oxlint --deny-warnings src tooling test scripts examples/integrations",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:site": "node scripts/docs-data.ts && vite build examples/showcase",
    "dev": "vite examples/showcase --host 127.0.0.1",
    "check": "pnpm build && pnpm typecheck && pnpm lint && oxfmt --check && node tooling/cli.ts check && pnpm test && pnpm build:site && pnpm test:browser && pnpm pack-check",
    "pack-check": "node scripts/pack-check.ts",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "intl-messageformat": "12.1.4",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@usevibejs/auth": "0.1.1",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/form": "0.1.1",
    "@usevibejs/language-tools": "0.1.0",
    "@usevibejs/query": "0.1.1",
    "@usevibejs/table": "0.1.1",
    "@usevibejs/ui": "0.1.0",
    "@usevibejs/use": "0.1.1",
    "@usevibejs/vibecn": "0.3.0",
    "clsx": "2.1.1",
    "jsdom": "30.1.3",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.2",
    "typescript": "7.1.0-dev.20261024.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@usevibejs/compiler": "^0.1.0",
    "@usevibejs/ui": "^0.1.0",
    "oxc-parser": "^0.155.0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "@usevibejs/compiler": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@11.18.0"
}
