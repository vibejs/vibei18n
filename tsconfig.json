{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "ESNext.Intl"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src", "tooling", "test", "scripts", "*.ts", "examples/integrations"]
}
