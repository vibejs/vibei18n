<script setup lang="ts">
import { ref } from "@usevibejs/ui";
import { useI18n } from "../../../src/index.ts";
import { routing } from "./routing.ts";
import LanguageSwitcher from "./components/ui/LanguageSwitcher.vibe";
import { languages } from "./i18n.ts";
import Customers from "./Customers.vibe";
import Settings from "./Settings.vibe";
import Labs from "./Labs.vibe";
import Auth from "./Auth.vibe";
import Documentation from "./Documentation.vibe";
import Button from "./components/ui/Button.vibe";
import Calendar from "./components/ui/Calendar.vibe";
import DirectionProvider from "./components/ui/DirectionProvider.vibe";
import Dialog from "./components/ui/Dialog.vibe";
import DialogTrigger from "./components/ui/DialogTrigger.vibe";
import DialogContent from "./components/ui/DialogContent.vibe";
import DialogTitle from "./components/ui/DialogTitle.vibe";
import DialogDescription from "./components/ui/DialogDescription.vibe";
import DialogClose from "./components/ui/DialogClose.vibe";
import Input from "./components/ui/Input.vibe";
const { t, d, n, rt, locale, dir, dynamic } = useI18n();
async function changeLocale(tag: string): Promise<void> {
  const failure = await routing.setLocale(tag);
  if (failure?.type === "aborted") throw new Error("Locale navigation failed.");
}
const tab = ref("dashboard"),
  dark = ref(false),
  date = ref<string | null>("2026-10-28"),
  dialog = ref(false),
  invite = ref(""),
  sent = ref(false),
  notifications = ref(false);
const nav = [
  { id: "dashboard", icon: "◫", label: "dashboard" },
  { id: "projects", icon: "▦", label: "projects" },
  { id: "settings", icon: "⚙", label: "settings" },
  { id: "playground", icon: "⌘", label: "playground" },
  { id: "login", icon: "↗", label: "login" },
  { id: "docs", icon: "≡", label: "docs" },
] as const;
</script>
<template>
  <DirectionProvider :dir="dir"
    ><div :class="['app-shell', dark && 'dark']" :lang="locale">
      <aside class="sidebar">
        <a class="brand" href="/en/dashboard"
          ><span class="brand-mark">v<span>i</span></span
          ><span>VibeI18n<small>Every Language. One Framework.</small></span></a
        >
        <div class="workspace-label">
          <span class="workspace-icon">A</span>
          <div>
            Atlas workspace<small>Team plan <span>⌄</span></small>
          </div>
        </div>
        <span class="nav-label">WORKSPACE</span>
        <nav aria-label="Workspace">
          <button
            v-for="item in nav"
            :key="item.id"
            :class="['nav-item', tab === item.id && 'active']"
            :aria-current="tab === item.id ? 'page' : undefined"
            @click="tab = item.id"
          >
            <span aria-hidden="true">{{ item.icon }}</span
            >{{ t(item.label) }}<span v-if="item.id === 'projects'" class="nav-count">6</span>
          </button>
        </nav>
        <div class="sidebar-note">
          <span class="note-glyph">Aa あ</span><strong>Built for every voice.</strong>
          <p>10 languages. One workspace.<br />Make yourself at home.</p>
          <button @click="tab = 'playground'">{{ t("learn") }} ↗</button>
        </div>
        <div class="sidebar-person">
          <span class="avatar">AM</span>
          <div><strong>Alex Morgan</strong><small>alex@example.test</small></div>
        </div>
      </aside>
      <div class="app-main">
        <header class="topbar">
          <div class="breadcrumb">
            Atlas <span>/</span> {{ t(nav.find((item) => item.id === tab)?.label ?? "dashboard") }}
          </div>
          <div class="top-actions">
            <button @click="dark = !dark" :aria-label="dark ? 'Light mode' : 'Dark mode'">
              {{ dark ? "☀" : "☾" }}</button
            ><span class="demo-badge">LIVE DEMO</span>
            <div class="language-switcher">
              <LanguageSwitcher
                :locales="languages"
                :label="t('language')"
                :empty-label="t('empty')"
                :loading-label="t('loading')"
                :retry-label="t('retry')"
                :change="changeLocale"
              />
            </div>
            <button
              class="notification-button"
              :aria-label="t('notifications')"
              @click="notifications = !notifications"
            >
              ♧<span></span>
            </button>
          </div>
        </header>
        <div v-if="notifications" class="notification-panel" role="status">
          <strong>{{ t("notifications") }}</strong>
          <p>{{ t("saved") }} · {{ rt(-5, "minute") }}</p>
        </div>
        <main id="details" class="main-content">
          <div class="page-heading">
            <div>
              <span class="eyebrow">ATLAS / {{ t("dashboard") }}</span>
              <h1>{{ t("overview") }}</h1>
              <p>{{ t("subtitle") }}</p>
            </div>
            <div class="heading-actions">
              <span class="date-chip"
                >▧ {{ d(Date.UTC(2026, 9, 28), { dateStyle: "medium" }) }}</span
              ><Dialog v-model:open="dialog"
                ><DialogTrigger>{{ t("invite") }} <span aria-hidden="true">＋</span></DialogTrigger
                ><DialogContent :show-close-button="false"
                  ><DialogTitle>{{ t("dialogTitle") }}</DialogTitle
                  ><DialogDescription>{{ t("dialogDescription") }}</DialogDescription>
                  <form @submit.prevent="sent = true">
                    <label for="invite-email">{{ t("email") }}</label
                    ><Input id="invite-email" type="email" v-model="invite" required /><Button
                      type="submit"
                      >{{ t("send") }}</Button
                    >
                  </form>
                  <p v-if="sent" role="status">{{ t("sent") }}: {{ invite }}</p>
                  <DialogClose>{{ t("close") }}</DialogClose></DialogContent
                ></Dialog
              >
            </div>
          </div>
          <div v-show="tab === 'dashboard' || tab === 'projects'">
            <div class="locale-banner">
              <span class="banner-symbol">文<span>↔</span>A</span>
              <div>
                <strong>{{ t("welcome", { name: "Alex" }) }}</strong>
                <p>{{ t("description") }}</p>
              </div>
              <span class="locale-pill">{{ locale }} <span>●</span></span>
            </div>
            <div class="stats">
              <article>
                <span>{{ t("revenue") }}</span
                ><strong data-testid="revenue">{{
                  n(48295.5, { style: "currency", currency: "USD" })
                }}</strong
                ><small><b>↗ 12.8%</b> · {{ t("updated") }}</small
                ><svg viewBox="0 0 180 40" aria-hidden="true">
                  <path
                    d="M0 34L16 30L32 33L48 18L64 22L80 12L96 15L112 7L128 12L144 3L160 6L180 0"
                  />
                </svg>
              </article>
              <article>
                <span>{{ t("members") }}</span
                ><strong>{{ n(2430) }}</strong
                ><small><b>↗ 8.2%</b> · {{ rt(-1, "day", { numeric: "auto" }) }}</small>
                <div class="mini-bars" aria-hidden="true">
                  <i
                    v-for="height in [28, 46, 35, 65, 48, 73, 58, 84, 74, 95]"
                    :key="height"
                    :style="{ height: height + '%' }"
                  ></i>
                </div>
              </article>
              <article>
                <span>{{ t("tasks") }}</span
                ><strong>{{ n(24) }}</strong
                ><small>{{ t("items", { count: 7 }) }}</small>
                <div class="task-meter" aria-hidden="true"><span></span></div>
              </article>
            </div>
            <Customers />
            <div class="bottom-panels">
              <Settings />
              <section class="panel calendar-panel">
                <span class="eyebrow">PLAN TOGETHER</span>
                <h2>{{ t("calendar") }}</h2>
                <Calendar
                  v-model="date"
                  :locale="locale"
                  :label="t('calendar')"
                  default-month="2026-10"
                />
                <p class="muted">{{ date }}</p>
              </section>
            </div>
            <p class="fallback-note" data-testid="fallback">{{ dynamic("help:fallback") }}</p>
          </div>
          <div v-show="tab === 'settings'"><Settings /></div>
          <div v-show="tab === 'playground'"><Labs /></div>
          <div v-show="tab === 'login'"><Auth /></div>
          <div v-show="tab === 'docs'"><Documentation /></div>
          <footer class="main-footer">
            <span>VibeI18n / 0.1.0</span><span>Demonstration translations · Not human reviewed</span
            ><span>ICU powered. Vibe native.</span>
          </footer>
        </main>
      </div>
    </div></DirectionProvider
  >
</template>
